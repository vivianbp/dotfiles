// Noctalia shell integration: startup, binds, and niri tweaks it needs.
// (noctalia.kdl is generated by noctalia's color template — don't edit that one.)

spawn-at-startup "noctalia"

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Space   hotkey-overlay-title="Run an Application: noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S       hotkey-overlay-title="Open noctalia control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen"              { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    // Mod+Comma hotkey-overlay-title="Open noctalia settings"      { spawn "noctalia" "msg" "settings-toggle"; }
    // Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }

    // Audio & Brightness
    XF86AudioRaiseVolume    { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume    { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute           { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute        { spawn "noctalia" "msg" "mic-mute"; }

    XF86MonBrightnessUp     { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown   { spawn "noctalia" "msg" "brightness-down"; }
}
window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 15

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}
